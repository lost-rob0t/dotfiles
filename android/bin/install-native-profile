#!/usr/bin/env bash
set -euo pipefail

readonly DOTFILES_DIR="${STAR_DOTFILES_ROOT:-$HOME/.dotfiles}"
readonly STOW_DIR="$DOTFILES_DIR/android/stow"
readonly TARGET="${EMACS_ANDROID_HOME:-$HOME}"

command -v stow >/dev/null 2>&1 || {
  printf 'install-native-profile: GNU Stow is required\n' >&2
  exit 127
}

[[ -d "$STOW_DIR/android-emacs" ]] || {
  printf 'install-native-profile: missing %s/android-emacs\n' "$STOW_DIR" >&2
  exit 1
}

stow --dir "$STOW_DIR" --target "$TARGET" --restow android-emacs
printf 'Installed native Android Emacs profile into %s\n' "$TARGET"
printf 'This profile loads Android Org configuration only; Doom is not started.\n'
