#!/usr/bin/env bash
set -euo pipefail

readonly program="${0##*/}"
readonly container_name="${A0_CONTAINER_NAME:-agent-zero}"
readonly image="${A0_IMAGE:-agent0ai/agent-zero:latest}"
readonly port="${A0_PORT:-5080}"
readonly usr_volume="${A0_USR_VOLUME:-a0_v2_usr}"
readonly nix_volume="${A0_NIX_VOLUME:-a0_nix}"

usage() {
  cat <<'EOF'
Usage: agent-zero-nix

Recreate Agent Zero with the existing persistent data volume and persistent Nix store.

Environment overrides:
  A0_CONTAINER_NAME  Container name (default: agent-zero)
  A0_IMAGE           Image (default: agent0ai/agent-zero:latest)
  A0_PORT            Host Web UI port (default: 5080)
  A0_USR_VOLUME      /a0/usr volume (default: a0_v2_usr)
  A0_NIX_VOLUME      /nix volume (default: a0_nix)
EOF
}

fail() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "") ;;
  *)
    usage >&2
    fail "unexpected argument: $1"
    ;;
esac

command -v docker >/dev/null 2>&1 || fail "docker is required"
[[ "$port" =~ ^[0-9]+$ ]] || fail "A0_PORT must be numeric"
(( 1 <= 10#$port && 10#$port <= 65535 )) || fail "A0_PORT out of range: $port"

docker volume inspect "$usr_volume" >/dev/null 2>&1 || \
  fail "existing Agent Zero volume not found: $usr_volume"
docker volume create "$nix_volume" >/dev/null

docker rm -f "$container_name" >/dev/null 2>&1 || true

docker run -d \
  --name "$container_name" \
  --restart unless-stopped \
  -p "$port:80" \
  -v "$usr_volume:/a0/usr" \
  -v "$nix_volume:/nix" \
  "$image" >/dev/null

sleep 2
if [[ "$(docker inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)" != "true" ]]; then
  printf 'Agent Zero failed to stay running. Recent logs:\n' >&2
  docker logs --tail 100 "$container_name" >&2 || true
  exit 1
fi

printf 'Agent Zero started: http://127.0.0.1:%s\n' "$port"
printf 'Agent Zero data: docker volume %s -> /a0/usr\n' "$usr_volume"
printf 'Persistent Nix store: docker volume %s -> /nix\n' "$nix_volume"
