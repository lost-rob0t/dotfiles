#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
umask 077
fail() { printf 'termux-starintel-client: %s\n' "$*" >&2; exit 2; }
root=$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)
cli="$root/nix/packages/starintel-admin/bin/starintel-admin"
[[ -f "$cli" ]] || fail 'tracked operator CLI is missing'
need_dependencies() {
  local command
  for command in bash curl jq openssl timeout python head wc mktemp rm; do
    command -v "$command" >/dev/null || fail "missing dependency: $command"
  done
}
endpoint() {
  python - <<'PY'
import os, sys
from urllib.parse import urlsplit
value = os.environ.get('STARINTEL_ADMIN_URL') or os.environ.get('STAR_SERVER_URL')
try:
    if not value or not value.isascii() or any(ord(c) <= 32 or ord(c) == 127 for c in value):
        raise ValueError()
    parsed = urlsplit(value)
    if (parsed.scheme != 'https' or not parsed.hostname or parsed.username is not None
            or parsed.password is not None or parsed.query or parsed.fragment):
        raise ValueError()
    parsed.port  # Validate the port without echoing a possibly sensitive URL.
except ValueError:
    sys.exit('termux-starintel-client: configure an explicit HTTPS base URL without credentials, query or fragment')
print(value.rstrip('/'))
PY
}
credentials() {
  python - "$root" <<'PY'
import os, stat, sys
from pathlib import Path
try:
    token = next((os.environ[k] for k in ('STARINTEL_ADMIN_TOKEN', 'STAR_SERVER_TOKEN', 'STAR_SERVER_API_KEY')
                  if os.environ.get(k)), None)
    if token is None:
        name = os.environ.get('STARINTEL_ADMIN_TOKEN_FILE')
        if not name or not Path(name).is_absolute() or Path(name).is_symlink():
            raise ValueError()
        path = Path(name).resolve(strict=True)
        info = path.stat()
        root = Path(sys.argv[1]).resolve()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077
                or path == root or root in path.parents or str(path).startswith('/nix/store/')):
            raise ValueError()
        with path.open() as stream:
            token = stream.readline(8193).rstrip('\n')
    if (not token or len(token) > 8192 or not token.isascii()
            or any(ord(c) <= 32 or ord(c) >= 127 or c in '"\\' for c in token)):
        raise ValueError()
except (OSError, UnicodeError, ValueError):
    sys.exit('termux-starintel-client: provide an explicit token environment variable or owner-private external token file')
PY
}
private_temporary_directory() {
  scratch=$(mktemp -d -t "$1.XXXXXXXX")
  trap 'rm -rf -- "$scratch"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
}
case "${1:-doctor}" in
  install)
    [[ $# == 1 ]] || fail 'install takes no arguments'
    : "${PREFIX:?Run inside Termux (PREFIX is required)}"
    need_dependencies
    [[ -x "$PREFIX/bin/bash" ]] || fail 'Termux Bash is missing'
    python - "$PREFIX" "$root/scripts/termux-starintel-client" <<'PY'
import os, shlex, sys, tempfile
from pathlib import Path
prefix, helper = map(Path, sys.argv[1:])
marker = '# Managed by dotfiles termux-starintel-client\n'
outputs = {}
for name, mode in (('starintel-admin', 'run'), ('starintel-admin-doctor', 'doctor')):
    target = prefix / 'bin' / name
    text = '#!/data/data/com.termux/files/usr/bin/bash\n' + marker
    text += 'exec ' + shlex.quote(str(prefix / 'bin/bash')) + ' ' + shlex.quote(str(helper)) + ' ' + mode + ' "$@"\n'
    for item in (target, *target.parents):
        if item.is_symlink():
            sys.exit('termux-starintel-client: refusing symlink in launcher path')
    if target.exists():
        if not target.is_file() or target.stat().st_nlink != 1 or marker not in target.read_text().split('exec ', 1)[0]:
            sys.exit('termux-starintel-client: refusing to replace an unrelated launcher')
    outputs[target] = text
for target, text in outputs.items():
    if target.exists() and target.read_text() == text:
        continue
    fd, temporary = tempfile.mkstemp(prefix='.' + target.name + '.', dir=target.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(text)
            stream.flush()
            os.fchmod(stream.fileno(), 0o755)
            os.fsync(stream.fileno())
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)
PY
    printf 'Installed remote client launchers; no endpoint, credentials or connection configured.\n'
    ;;
  run)
    shift
    need_dependencies
    case "${1:---help}" in
      --help|-h|help|--version|version) exec bash "$cli" "$@" ;;
    esac
    export STARINTEL_ADMIN_URL
    STARINTEL_ADMIN_URL=$(endpoint)
    credentials
    private_temporary_directory starintel-client
    TMPDIR="$scratch" bash "$cli" "$@"
    ;;
  doctor)
    [[ $# == 1 || ( $# == 2 && "$2" == --connect ) ]] || fail 'usage: starintel-admin-doctor [--connect]'
    need_dependencies
    if [[ $# == 1 ]]; then
      if [[ -n "${STARINTEL_ADMIN_URL:-${STAR_SERVER_URL:-}}" ]]; then
        endpoint >/dev/null
        printf 'Dependencies ready; endpoint configured. No connection attempted.\n'
      else
        printf 'Dependencies ready; endpoint not configured. No connection attempted.\n'
      fi
      exit 0
    fi
    export STARINTEL_ADMIN_URL
    STARINTEL_ADMIN_URL=$(endpoint)
    credentials
    private_temporary_directory starintel-doctor
    export STARINTEL_ADMIN_CURL=curl
    set +e
    TMPDIR="$scratch" timeout -k 2 20 bash "$cli" key list 2>/dev/null |
      head -c 1048577 > "$scratch/response"
    result=("${PIPESTATUS[@]}")
    set -e
    if (( result[0] || result[1] )) || [[ $(wc -c < "$scratch/response") -gt 1048576 ]] ||
       ! jq -e 'type == "array"' "$scratch/response" >/dev/null 2>&1; then
      fail 'read-only diagnostic failed (connection, authorization, deadline or response limit); response hidden'
    fi
    printf 'Remote credential-list API reachable and authorized (read-only).\n'
    ;;
  *) fail 'usage: termux-starintel-client {install|run [CLI arguments]|doctor [--connect]}' ;;
esac
